uint8_t packed[C_SIZE]; uint8_t prev[1024], cur[1024];
uint8_t b85val(char c){ for(uint8_t i=0;i<85;i++) if(pgm_read_byte(B85+i)==c) return i; return 0; }
void decode85(){ uint32_t o=0; for(uint32_t i=0;i<ENC_SIZE;i+=5){ uint64_t n=0; for(uint8_t j=0;j<5;j++) n=n*85+b85val(pgm_read_byte(DATA+i+j)); for(int8_t j=3;j>=0;j--){ uint8_t v=n>>(j*8); if(o<C_SIZE) packed[o++]=v; } } }
uint32_t streamPos=0;
void render(){ uint8_t *b=display.getBuffer(); memset(b,0,1024); for(uint16_t y=0;y<H;y++) for(uint16_t x=0;x<W;x++) if(cur[y*16+(x>>3)]&(0x80>>(x&7))) b[x+(y>>3)*W]|=1<<(y&7); display.display(); }
void unpackFrame(uint16_t f){ uint16_t len=packed[streamPos]|(uint16_t(packed[streamPos+1])<<8); streamPos+=2; uint32_t end=streamPos+len; uint16_t i=0; while(i<1024){ uint8_t flags=packed[streamPos++]; for(uint8_t b=0;b<8&&i<1024;b++){ if(flags&(1<<b)) cur[i++]=packed[streamPos++]; else { uint8_t lo=packed[streamPos++], hi=packed[streamPos++]; uint16_t at=lo|((hi&15)<<8); uint8_t n=(hi>>4)+3; while(n--&&i<1024) cur[i++]=cur[at++]; } } } if(f%KEYINT) for(uint16_t k=0;k<1024;k++) cur[k]^=prev[k]; memcpy(prev,cur,1024); streamPos=end; }
void setup(){ Wire.begin(SDA_PIN,SCL_PIN); Wire.setClock(400000); display.begin(SSD1306_SWITCHCAPVCC,0x3C); display.clearDisplay(); display.display(); decode85(); memset(prev,0,1024); }
void loop(){ static uint16_t tick=0,last=65535; static uint32_t next=0; if(!next) next=micros(); uint16_t src=(uint32_t(tick)*FRAMES)/TICKS; if(src!=last){ unpackFrame(src); render(); last=src; } tick++; if(tick>=TICKS){ tick=0; last=65535; streamPos=0; memset(prev,0,1024); } next+=33333; while((int32_t)(next-micros())>0){} }
